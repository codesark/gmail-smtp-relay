services:
  go-smtp-gmail-relay:
    image: codesark/gmail-smtp-relay:latest
    container_name: go-smtp-gmail-relay
    restart: unless-stopped
    env_file: .env
    ports:
      - "465:465"
      - "587:587"
    volumes:
      - ./storage/relay-data:/app/data
      - ./storage/certs:/certs:ro
    depends_on:
      acme-renew:
        condition: service_completed_successfully

  dns-sync:
    image: python:3.12-alpine
    container_name: relay-dns-sync
    restart: on-failure
    env_file: .env
    command: python3 /work/scripts/cloudflare-dns-sync.py
    volumes:
      - ./:/work:ro

  acme-renew:
    image: certbot/dns-cloudflare:latest
    container_name: relay-acme-renew
    restart: "no"
    env_file: .env
    entrypoint:
      - /bin/sh
      - -c
    # command MUST be a single-element list: a plain string here gets
    # shell-lexed into words by compose, and with the `sh -c` entrypoint
    # only the first word would run (silent no-op).
    command:
      - >
        command -v bash >/dev/null 2>&1 ||
        (command -v apk >/dev/null 2>&1 && apk add --no-cache bash >/dev/null) ||
        (command -v apt-get >/dev/null 2>&1 && apt-get update >/dev/null &&
        apt-get install -y --no-install-recommends bash >/dev/null &&
        rm -rf /var/lib/apt/lists/*);
        exec bash /work/scripts/acme-cloudflare.sh
    volumes:
      - ./:/work:ro
      - ./storage/certs:/certs
      - ./storage/letsencrypt/config:/etc/letsencrypt
      - ./storage/letsencrypt/work:/var/lib/letsencrypt
      - ./storage/letsencrypt/logs:/var/log/letsencrypt
      # needed so the renew script can restart the relay after deploying
      # a new certificate (set RELAY_RESTART_CONTAINER in .env)
      - /var/run/docker.sock:/var/run/docker.sock

  acme-renew-loop:
    image: certbot/dns-cloudflare:latest
    container_name: relay-acme-renew-loop
    restart: unless-stopped
    env_file: .env
    environment:
      - ACME_RENEW_ONCE=false
    entrypoint:
      - /bin/sh
      - -c
    # single-element list — see acme-renew above
    command:
      - >
        command -v bash >/dev/null 2>&1 ||
        (command -v apk >/dev/null 2>&1 && apk add --no-cache bash >/dev/null) ||
        (command -v apt-get >/dev/null 2>&1 && apt-get update >/dev/null &&
        apt-get install -y --no-install-recommends bash >/dev/null &&
        rm -rf /var/lib/apt/lists/*);
        exec bash /work/scripts/acme-cloudflare.sh
    volumes:
      - ./:/work:ro
      - ./storage/certs:/certs
      - ./storage/letsencrypt/config:/etc/letsencrypt
      - ./storage/letsencrypt/work:/var/lib/letsencrypt
      - ./storage/letsencrypt/logs:/var/log/letsencrypt
      - /var/run/docker.sock:/var/run/docker.sock
    depends_on:
      acme-renew:
        condition: service_completed_successfully
